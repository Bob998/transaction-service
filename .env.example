APP_IMAGE=transaction-service:local
APP_VERSION=local
POSTGRES_DB=transaction_db
POSTGRES_USER=transaction_user
POSTGRES_PASSWORD=transaction_password
APP_PORT=8080
APP_MEMORY_LIMIT=768m
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:NativeMemoryTracking=summary -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/tmp
PERFORMANCE_LAB_ENABLED=true
TOMCAT_MAX_THREADS=100
TOMCAT_MIN_SPARE_THREADS=10
TOMCAT_ACCEPT_COUNT=100
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=2000
PERF_WORKER_CORE_SIZE=4
PERF_WORKER_MAX_SIZE=8
PERF_WORKER_QUEUE_CAPACITY=20
PERF_DATABASE_WORKERS=20
JMETER_THREADS=10
JMETER_RAMP_SECONDS=10
JMETER_DURATION_SECONDS=60
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
